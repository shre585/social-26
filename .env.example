# ==============================================================================
# SOCIAL MEDIA REPURPOSER CONFIGURATION
# ==============================================================================

# LLM Provider selection: "gemini", "openai", "anthropic", or leave empty to auto-detect.
# If no API key is provided, the application runs seamlessly in intelligent heuristic mode.
LLM_PROVIDER=

# Google Gemini API
# Note: gemini-2.0-flash was decommissioned in 2026. Use gemini-3.5-flash-lite or gemini-3.6-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Speech-to-Text (faster-whisper)
# Models: tiny, base, small, medium, large-v3 (base is optimal for local CPU execution)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Binary executables (ensure on PATH or specify full path)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Storage and limits
MAX_UPLOAD_MB=1024
MAX_CONCURRENT_JOBS=2
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,*
